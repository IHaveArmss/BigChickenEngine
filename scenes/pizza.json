            "text": "What's up small fella, would you like to order?",
            "next": "choices"
          },
          "response_a": {
            "speaker": "NPC_Guardian",
            "text": "Are you serious?",
            "next": "exit"
          },
          "response_b": {
            "speaker": "NPC_Guardian",
            "text": "You're in luck, I got a job for you.",
            "next": "exit"
          },
          "choices": {
            "speaker": "NPC_Guardian",
            "text": "What would you like to do?",
            "choices": [
              {
                "text": "Give me the cheapest thing you got!",
                "next": "response_a"
              },
              {
                "text": "Looking for something extra..",
                "next": "response_b"
              },
              {
                "text": "I shot that thief...",
                "next": "thief_shot_response",
                "requires": {"thief_shot": true}
              }
            ]
          },
          "thief_shot_response": {
            "speaker": "NPC_Guardian",
            "text": "You shot him?! Man, you're more cold-blooded than I thought. But thanks... I guess.",
            "next": "exit"
          }
        }
